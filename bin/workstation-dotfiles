#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd) || { printf 'refusal\tROOT\n' >&2; exit 1; }
if [ "${1:-}" = inventory ] && [ "${2:-}" = verify ]; then
  exec "$root/dotfiles/.workstation/bin/workstation-dotfiles" --inventory "$root/consolidation/v1/inventory.tsv" "$@"
fi
exec "$root/dotfiles/.workstation/bin/workstation-dotfiles" "$@"
