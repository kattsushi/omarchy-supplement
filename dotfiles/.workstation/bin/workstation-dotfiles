#!/usr/bin/env bash
set -euo pipefail
here=$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd) || { printf 'refusal\tROOT\n' >&2; exit 1; }
root=$(CDPATH='' cd -- "$here/../.." 2>/dev/null && pwd) || { printf 'refusal\tROOT\n' >&2; exit 1; }
# shellcheck disable=SC1091 # Dynamic repository-root source path.
. "$root/.workstation/lib/common.sh"
# shellcheck disable=SC1091 # Dynamic repository-root source path.
. "$root/.workstation/lib/source.sh"
# shellcheck disable=SC1091 # Dynamic repository-root source path.
. "$root/.workstation/lib/materialize.sh"
inventory=
if [ "${1:-}" = --inventory ]; then inventory=${2:-}; shift 2; fi
case "${1:-}:${2:-}" in
inventory:verify)
  manifest_valid "$root/.workstation/source-files.tsv"
  if [ -n "$inventory" ]; then
projection=$(mktemp "${TMPDIR:-/tmp}/workstation-inventory.XXXXXX" 2>/dev/null) || refuse INVENTORY
        if ! [ -f "$inventory" ] || ! awk -F '\t' 'NR==1 || $9=="include"' "$inventory" > "$projection" 2>/dev/null || ! cmp -s "$root/.workstation/source-files.tsv" "$projection" 2>/dev/null; then
          rm -f -- "$projection"
          refuse INVENTORY
        fi
        rm -f -- "$projection"
  fi
  printf 'inventory\tVERIFY\tPASS\n';;
source:verify) verify_source "$root"; printf 'source\tVERIFY\tPASS\n';;
materialize:*) shift; materialize "$root" "$@";;
stow:packages)
  shift 2; profile=''; platform=''
  while [ "$#" -gt 0 ]; do case $1 in --profile) profile=${2:-}; shift 2;; --platform) platform=${2:-}; shift 2;; *) refuse ARGUMENT;; esac; done
  [ -n "$profile" ] || refuse PROFILE
  [ -n "$platform" ] || case "$(uname -s)" in Linux) platform=linux;; Darwin) platform=darwin;; *) refuse PLATFORM;; esac
  row=$(awk -F '\t' -v p="$profile" '$1==p {print}' "$root/.workstation/profiles.tsv" 2>/dev/null) || refuse PROFILE
  [ "$(printf '%s\n' "$row" | sed '/^$/d' | wc -l 2>/dev/null)" = 1 ] || refuse PROFILE
  IFS=$'\t' read -r _ expected packages <<< "$row"; [ "$expected" = any ] || [ "$expected" = "$platform" ] || refuse PLATFORM
  profiles_valid "$root/.workstation/profiles.tsv" "$root"; printf '%s' "$packages" | tr , '\n' | LC_ALL=C sort | while read -r package; do printf 'package\t%s\n' "$package"; done;;
*) refuse COMMAND;;
esac
